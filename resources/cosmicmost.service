[Unit]
Description=Sync the COSMIC theme to Mattermost
Documentation=https://github.com/cosmic-utils/mattermost-theme-sync
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cosmicmost daemon
Restart=on-failure
RestartSec=5s
Environment=RUST_LOG=warn,cosmicmost=info

[Install]
WantedBy=default.target
